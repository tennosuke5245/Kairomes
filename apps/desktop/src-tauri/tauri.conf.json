{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairomes",
  "version": "0.1.2",
  "identifier": "dev.tennosuke.kairomes",
  "build": {
    "beforeDevCommand": "bun run tauri:before-dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run tauri:before-build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kairomes",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/kairomes-runtime"],
    "resources": {
      "binaries/resources/": "resources/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
